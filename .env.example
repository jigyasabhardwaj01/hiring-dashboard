# ---- AI (swappable) ----
# gemini | anthropic | openai | mock   (mock = built-in demo writer, no API key needed)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional. Defaults: gemini -> gemini-3.8-flash, anthropic -> claude-sonnet-5-5, openai -> gpt-4o
LLM_MODEL=

# ---- Email (Resend) ----
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Acme Hiring <hiring@acme.com>"
EMAIL_FROM=

# ---- Database (optional) ----
# Neon / Postgres connection string. Table is created automatically.
DATABASE_URL=
# Or Supabase. Leave all blank to store everything in ./data on this computer.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Your details (used in emails) ----
COMPANY_NAME=Acme
FOUNDER_NAME=Founder

# ---- Behaviour ----
# Applied-role score at or above this => "interview", below => "reject"
INTERVIEW_THRESHOLD=65
# Load 4 sample candidates on first run
SEED_SAMPLE_DATA=true
